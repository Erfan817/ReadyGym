# ReadyGym 服务端配置示例（字段清单，不含真实值）
# 本地可复制为 server/.env；生产请用 systemd EnvironmentFile=/etc/readygym.env（chmod 600）。
# server/.env 已被 .gitignore 排除，切勿把真实值写进本文件并提交。

# 运营面板 / 管理接口 token。必须随机生成并定期轮换；留空时 /api/admin/** 全部返回 403。
READYGYM_ADMIN_TOKEN=

# AI 网关（服务端代理回落时使用）。默认发行包走 App 直连，但以下三项必须保持有效：
# 新克隆仓库、CI 构建或漏配 android/local.properties 时，App 会自动回落到 /api/ai。
DEEPSEEK_API_KEY=
READYGYM_DEEPSEEK_BASE_URL=https://www.packyapi.ai/v1
READYGYM_DEEPSEEK_MODEL=deepseek-flash

# 服务端 AI 代理的策略（application.yml 有默认值）
# READYGYM_AI_DAILY_LIMIT=60
# READYGYM_AI_MAX_TOKENS=4000

# 讯飞语音听写（留空则语音接口不可用，App 会回落系统识别或提示）
READYGYM_XFYUN_APP_ID=
READYGYM_XFYUN_API_KEY=
READYGYM_XFYUN_API_SECRET=

# 可选：外置 GIF 全量镜像目录、安装包下载目录（留空则用 jar 内子集 / 关闭下载路由）
READYGYM_GIFS_DIR=
READYGYM_DOWNLOADS_DIR=

# H2 文件库口令。留空沿用默认（本地开发可接受），生产建议设置。
READYGYM_H2_PASSWORD=

# 仅 --spring.profiles.active=mysql 时使用
# MYSQL_URL=jdbc:mysql://localhost:3306/readygym?useSSL=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
# MYSQL_USER=readygym
# MYSQL_PASSWORD=

# 正式 APK 签名（由 android/app/build.gradle.kts 读取；四项齐全且 keystore 文件存在才启用）
# READYGYM_KEYSTORE_FILE=
# READYGYM_KEYSTORE_PASSWORD=
# READYGYM_KEY_ALIAS=
# READYGYM_KEY_PASSWORD=

# VPS 部署脚本读取（见 docs/OPERATIONS.md）
# READYGYM_VPS_HOST=
# READYGYM_VPS_SSH_PORT=
# READYGYM_VPS_USER=
# READYGYM_VPS_PASSWORD=
