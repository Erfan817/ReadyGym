<resources>
    <style name="Theme.ReadyGym" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Matches ReadyGymColors.Background so the window behind Compose never flashes a
             different colour during launch. -->
        <item name="android:statusBarColor">#F3F2F7</item>
        <item name="android:navigationBarColor">#F3F2F7</item>
        <item name="android:windowBackground">#F3F2F7</item>
        <item name="android:colorAccent">#34C85A</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
